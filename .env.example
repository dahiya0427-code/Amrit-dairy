# ── Required ────────────────────────────────────────────────
# Neon Postgres connection string (use the *pooled* URL on Vercel)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-south-1.aws.neon.tech/amrit_dairy?sslmode=require
# Long random string used by Payload to sign sessions
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://amritdairy.in

# ── Media storage (Vercel Blob). If empty, uploads are stored on local disk (dev only)
BLOB_READ_WRITE_TOKEN=

# ── Email (Resend). If empty, emails are logged to the console
RESEND_API_KEY=
EMAIL_FROM=orders@mail.amritdairy.in
ORDER_NOTIFY_EMAIL=contact@amritdairy.in

# ── Payments (Razorpay). If empty, checkout falls back to "Pay on WhatsApp"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Seed: first admin user created by `pnpm seed`
SEED_ADMIN_EMAIL=contact@amritdairy.in
SEED_ADMIN_PASSWORD=change-me
